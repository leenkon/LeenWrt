#!/bin/sh
# DNS 劫持(绑定 ADGH 生命周期)：LAN 明文 :53 重定向到本机 ADGH(:5353)，dnsmasq 常驻 :53 作兜底。
# ADGH 宕则清表、LAN 直落 dnsmasq :53(掉过滤但不掉网，零抖动)；由 adguardhome init.d 监控循环调用。
# priority -150 早于 firewall4 dstnat(-100)；旁路由 IP 由 lan.ipaddr 末段推 .2 放行自身查询避免环路。
if ! command -v nft >/dev/null 2>&1; then
    logger -t dns-hijack "ERROR: nft not found"
    exit 0
fi

nft delete table inet dns_hijack 2>/dev/null

# 仅当 ADGH 安装且监听 :5353 才劫持(脚本由 adguardhome init.d 调用)
if [ ! -x /usr/bin/AdGuardHome ]; then
    logger -t dns-hijack "AdGuardHome 未安装，跳过劫持（回退 dnsmasq :53）"
    exit 0
fi
port_listen() {
    if command -v ss >/dev/null 2>&1; then
        ss -lun 2>/dev/null | grep -q ':5353 '
    elif command -v netstat >/dev/null 2>&1; then
        netstat -lun 2>/dev/null | grep -q ':5353 '
    else
        return 1
    fi
}
if ! port_listen; then
    logger -t dns-hijack "AdGuardHome 未在监听 :5353，清劫持回退 dnsmasq :53（零抖动）"
    exit 0
fi

nft add table inet dns_hijack
nft add chain inet dns_hijack prerouting '{ type nat hook prerouting priority -150; }'

LAN_IP=$(uci -q get network.lan.ipaddr 2>/dev/null)
BYPASS_IP=""
[ -n "$LAN_IP" ] && BYPASS_IP=$(echo "$LAN_IP" | sed 's/\.[0-9]*$/.2/')

if [ -n "$BYPASS_IP" ] && [ "$BYPASS_IP" != "$LAN_IP" ]; then
    # 双路由部署：放行旁路由自身查询，其余重定向到本机 :5353(ADGH)
    nft add rule inet dns_hijack prerouting ip saddr != $BYPASS_IP udp dport 53 redirect to :5353
    nft add rule inet dns_hijack prerouting ip saddr != $BYPASS_IP tcp dport 53 redirect to :5353
    logger -t dns-hijack "nftables DNS hijack applied (bypass: $BYPASS_IP)"
else
    # 单路由：IPv4 全量劫持
    nft add rule inet dns_hijack prerouting udp dport 53 redirect to :5353
    nft add rule inet dns_hijack prerouting tcp dport 53 redirect to :5353
    logger -t dns-hijack "nftables DNS hijack applied (single router, no bypass)"
fi

# IPv6 明文 DNS 一并重定向(旁路由多为 IPv4，不作排除)
nft add rule inet dns_hijack prerouting meta nfproto ipv6 udp dport 53 redirect to :5353
nft add rule inet dns_hijack prerouting meta nfproto ipv6 tcp dport 53 redirect to :5353
