#!/bin/sh
# LAN :53 → :5353(ADGH)；ADGH 未就绪则清表回退 dnsmasq :53（零抖动）。
# priority -150 早于 firewall4 dstnat(-100)；仅 br-lan 入向，避免 ADGH 自身上游 127.0.0.1:53 被重定向成环。
# dns_hijack_bypass_ip 空=全量劫持；按地址族排除旁路；ADGH 须 bind 0.0.0.0 + :: 5353。
if ! command -v nft >/dev/null 2>&1; then
    logger -t dns-hijack "ERROR: nft not found"
    exit 0
fi

TABLE="inet dns_hijack"
STATE="/var/run/dns-hijack.bypass"

port_listen() {
    if command -v ss >/dev/null 2>&1; then
        ss -lun 2>/dev/null | grep -q ':5353'
    elif command -v netstat >/dev/null 2>&1; then
        netstat -lun 2>/dev/null | grep -q ':5353'
    else
        return 1
    fi
}

# ADGH 未装/未监听：清表回退 dnsmasq :53（零抖动），清签名退出
if [ ! -x /usr/bin/AdGuardHome ] || ! port_listen; then
    nft delete table $TABLE 2>/dev/null
    rm -f "$STATE" 2>/dev/null
    exit 0
fi

BYPASS_IP=$(uci -q get adguardhome.config.dns_hijack_bypass_ip 2>/dev/null)

# 防抖：已监听且规则就位且旁路配置未变则跳过，避免周期性拆表致 DNS 瞬时回落；
# 旁路变更(STATE 不一致)必须重建，否则旧规则残留致新旁路不生效（违背 0 防抖）。
if nft list table $TABLE 2>/dev/null | grep -q 'dport 53 redirect to :5353' \
   && [ "$(cat "$STATE" 2>/dev/null)" = "${BYPASS_IP:-}" ]; then
    exit 0
fi

# 按地址族排除旁路，避免错配致 nft 编译失败
RULE4=""; RULE6=""
[ -n "$BYPASS_IP" ] && case "$BYPASS_IP" in
    *:*) RULE6="ip6 saddr != $BYPASS_IP" ;;
    *)   RULE4="ip saddr != $BYPASS_IP" ;;
esac

# 原子重建：flush table + 声明式规则同在一个 nft -f 事务，flush 与加载一次生效，无中间态抖动。
# 勿省 flush：nft -f 对已存在 chain 是 append 语义，重复执行规则逐次累积，旧的无排除规则先匹配
# 会让旁路变更失效。勿用 delete table：表不存在时整批回滚→劫持表永不创建（先 add table 保证存在）。
nft add table $TABLE 2>/dev/null || { logger -t dns-hijack "ERROR: nft add table failed"; exit 0; }
nft -f - <<EOF
flush table $TABLE
table $TABLE {
    chain prerouting {
        type nat hook prerouting priority -150;
        iifname "br-lan" ${RULE4:-} udp dport 53 redirect to :5353
        iifname "br-lan" ${RULE4:-} tcp dport 53 redirect to :5353
        iifname "br-lan" meta nfproto ipv6 ${RULE6:-} udp dport 53 redirect to :5353
        iifname "br-lan" meta nfproto ipv6 ${RULE6:-} tcp dport 53 redirect to :5353
    }
}
EOF
_rc=$?
if [ "$_rc" -eq 0 ]; then
    echo "${BYPASS_IP:-}" > "$STATE" 2>/dev/null
else
    logger -t dns-hijack "ERROR: nft ruleset apply failed (rc=$_rc)"
fi
