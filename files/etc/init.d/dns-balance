#!/bin/sh /etc/rc.common
# 事件驱动 DNS 自愈合：ADGH/OC/dhcp 配置变更与接口 up 经 procd trigger 即时重建劫持表与 dnsmasq 上游；
# 60s 看门狗仅补"OC 崩溃被 procd 拉起"等无显式事件触发的边界(替代原 5s 轮询)。与 ADGH/OC 生命周期解耦；
# set_upstream 幂等(仅状态真变化才 restart dnsmasq)，是 dnsmasq 上游唯一管理者。
USE_PROCD=1
START=20
STOP=80

oc_listening() {
	# OC DNS 可能仅监听 UDP；/proc/net/{tcp,udp} 端口均为十六进制 1EC2(7874)。
	# 用 cat 汇总再 grep：部分内核无 tcp6/udp6，缺失文件不应让 grep 返回错误码
	[ -x /etc/init.d/openclash ] && cat /proc/net/tcp /proc/net/tcp6 /proc/net/udp /proc/net/udp6 2>/dev/null | grep -qi ':1ec2 '
}

# 按 OC(:7874) 实际监听态与网络拓扑设置 dnsmasq 上游；幂等，仅变化时重写并 restart。
set_upstream() {
	# uci get 对 list 逐行输出(换行分隔)，与 _desired 比较前须同样归一化，否则每次看门狗都误判变化
	cur=$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null | tr '\n' ' ' | tr -s ' ' | sed 's/^ //; s/ $//')
	_oc=""; oc_listening && _oc='127.0.0.1#7874'
	_desired=""
	for s in $cur; do
		[ "$s" = "127.0.0.1#7874" ] && continue
		_desired="$_desired $s"
	done
	if [ -z "$_desired" ]; then
		if uci -q get network.wan >/dev/null 2>&1; then
			_desired='223.5.5.5 223.6.6.6'
		else
			_desired=$(uci -q get network.lan.gateway)
		fi
	fi
	_desired=$(printf '%s\n' "$_oc $_desired" | tr '\n' ' ' | tr -s ' ' | sed 's/^ //; s/ $//')
	[ "$cur" = "$_desired" ] && return 0
	uci -q delete dhcp.@dnsmasq[0].port
	uci set dhcp.@dnsmasq[0].noresolv='1'
	uci set dhcp.@dnsmasq[0].dns_redirect='0'
	uci -q delete dhcp.@dnsmasq[0].server
	for s in $_desired; do
		[ -n "$s" ] && uci add_list dhcp.@dnsmasq[0].server="$s"
	done
	# 有 wan：绕 ISP 污染，peerdns 关、wan.dns 与 resolv.conf 回指 dnsmasq
	if uci -q get network.wan >/dev/null 2>&1; then
		uci set network.wan.peerdns='0'
		uci set network.wan.dns='127.0.0.1'
		printf 'nameserver 127.0.0.1\n' > /etc/resolv.conf 2>/dev/null || true
	fi
	uci commit dhcp
	/etc/init.d/dnsmasq restart 2>/dev/null
}

reconcile() {
	# 无 ADGH / 关劫持的构建会删掉 dns-hijack，门控避免 60s 看门狗反复报 not found
	[ -x /usr/sbin/dns-hijack ] && /usr/sbin/dns-hijack
	set_upstream
}

reconcile_loop() {
	reconcile
	while true; do
		sleep 60
		reconcile
	done
}

start_service() {
	procd_open_instance dns-balance
	procd_set_param command /bin/sh -c '. /etc/init.d/dns-balance; reconcile_loop'
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	reconcile
}

# 停止：dns-hijack 按 ADGH 监听态保留或自清劫持；dnsmasq 上游由 set_upstream 归位
stop_service() {
	[ -x /usr/sbin/dns-hijack ] && /usr/sbin/dns-hijack 2>/dev/null
	set_upstream 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger adguardhome
	procd_add_reload_trigger openclash
	procd_add_reload_trigger dhcp
	procd_add_raw_trigger 'interface.*.up' 5000 /etc/init.d/dns-balance reload
}
