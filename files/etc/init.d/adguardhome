#!/bin/sh /etc/rc.common
#
# AdGuardHome 启动脚本（官方预编译二进制方案）
# 取代 feeds 包的 init：以 root 运行（绑定 53 需特权），无需 capabilities jail。
# 配置复用 files/etc/adguardhome/adguardhome.yaml，运行时数据放在 /var/lib/adguardhome。

START=19
STOP=89
USE_PROCD=1

PROG=/usr/bin/AdGuardHome

boot() {
	ADGUARDHOME_BOOT=1
	start "$@"
}

# 统一设置 dnsmasq 端口：ADGH 模式让出 :53 退居 :5453，传空则复位 :53(保留构建期上游 server)。
setup_dnsmasq() {
	local port="$1"
	if [ -n "$port" ]; then
		uci -q set dhcp.@dnsmasq[0].port="$port"
	else
		uci -q delete dhcp.@dnsmasq[0].port
	fi
	uci set dhcp.@dnsmasq[0].noresolv='1'
	uci set dhcp.@dnsmasq[0].dns_redirect='0'
	uci commit dhcp
	/etc/init.d/dnsmasq restart 2>/dev/null
}

start_service() {
	# 开机阶段先不启动，等接口 up 后再拉起，避免网络未就绪导致解析失败
	[ -n "$ADGUARDHOME_BOOT" ] && return 0

	config_load adguardhome
	local enabled
	config_get_bool enabled config enabled 1
	[ "$enabled" = "1" ] || return 1

	# ADGH 拉起前让 dnsmasq 回 :5453，避免 stop->restart 抢 :53
	setup_dnsmasq 5453

	mkdir -m 0700 -p /var/lib/adguardhome

	procd_open_instance adguardhome
	procd_set_param command "$PROG" \
		--config /etc/adguardhome/adguardhome.yaml \
		--work-dir /var/lib/adguardhome \
		--no-check-update \
		--logfile syslog
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	# 劫持绑定 ADGH 生命周期：监听 :53 后布表；停时清表(stop_service)。dns_hijack=0 不劫持。
	local dhijack
	config_get_bool dhijack config dns_hijack 1
	if [ "$dhijack" = "1" ] && [ -x /usr/sbin/dns-hijack ]; then
		( local i
		  for i in $(seq 1 20); do
			if ss -lun 2>/dev/null | grep -q ':53 ' || netstat -lun 2>/dev/null | grep -q ':53 '; then
				chmod 755 /usr/sbin/dns-hijack
				/usr/sbin/dns-hijack
				logger -t adguardhome "ADGH 已监听 :53，已布 DNS 劫持"
				break
			fi
			sleep 1
		  done ) &
	fi
}

# ADGH 停止/卸载立即自愈：清劫持表 + 复位 dnsmasq :53。
# LeenWrt 的 dnsmasq 在 ADGH 模式占 :5453，仅清表(LeenWrt2 做法)会致 :53 无监听断网，故额外复位。
stop_service() {
	nft delete table inet dns_hijack 2>/dev/null
	setup_dnsmasq
	logger -t adguardhome "ADGH 停止/卸载：已清除劫持并回退 dnsmasq :53（自愈防断网）"
}

service_triggers() {
	procd_add_reload_trigger adguardhome
	if [ -n "$ADGUARDHOME_BOOT" ]; then
		# 等待接口 up 后真正启动（解决 https://github.com/openwrt/packages/issues/21868 类问题）
		procd_add_raw_trigger 'interface.*.up' 5000 /etc/init.d/adguardhome restart
	fi
}
