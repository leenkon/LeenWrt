#!/bin/sh /etc/rc.common
# AdGuardHome 启动脚本（官方预编译二进制方案）
# 以 root 运行（procd respawn/数据目录权限所需）；ADGH 监听 :5353，dnsmasq 占 :53 兜底。
# 配置复用 files/etc/adguardhome/adguardhome.yaml，数据落在 /etc/adguardhome/data（overlay 持久）。
# 注意：/var 是 /tmp 软链(tmpfs)，勿放 /var/lib/，否则重启丢过滤器。
START=19
STOP=89
USE_PROCD=1

PROG=/usr/bin/AdGuardHome

boot() {
	ADGUARDHOME_BOOT=1
	start "$@"
}

# dnsmasq 上游由独立常驻服务 dns-balance 全权管理(与 ADGH 生命周期解耦)，本脚本不触碰上游。

start_service() {
	[ -n "$ADGUARDHOME_BOOT" ] && return 0   # 开机先不启动，等接口 up 再拉起

	config_load adguardhome
	local enabled
	config_get_bool enabled config enabled 1
	[ "$enabled" = "1" ] || return 1

	# ADGH 二进制缺失：不抢占 :53，回退 dnsmasq :53，避免断网
	if [ ! -x "$PROG" ]; then
		logger -t adguardhome "AdGuardHome 未安装，回退 dnsmasq :53（不布劫持）"
		return 1
	fi

	mkdir -m 0700 -p /etc/adguardhome/data

	procd_open_instance adguardhome
	procd_set_param command "$PROG" \
		--config /etc/adguardhome/adguardhome.yaml \
		--work-dir /etc/adguardhome/data \
		--no-check-update \
		--logfile syslog
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	# 立即布劫持表；常驻自愈合(ADGH:5353 / OC:7874 监听态)由独立服务 dns-balance 负责
	[ -x /usr/sbin/dns-hijack ] && /usr/sbin/dns-hijack
}

# 停止即清劫持表(零抖动)；dnsmasq 上游由 dns-balance 继续自愈合管理
stop_service() {
	nft delete table inet dns_hijack 2>/dev/null
	logger -t adguardhome "ADGH 停止/卸载：已清除劫持（上游由 dns-balance 自愈合）"
}

service_triggers() {
	procd_add_reload_trigger adguardhome
	if [ -n "$ADGUARDHOME_BOOT" ]; then
		# 等待接口 up 后真正启动（解决 https://github.com/openwrt/packages/issues/21868 类问题）
		procd_add_raw_trigger 'interface.*.up' 5000 /etc/init.d/adguardhome restart
	fi
}
