# LeenWrt 旁路由(Mini) 独有 .config 项
# 定位：纯去广告 + 代理服务；主路由承担拨号 / DHCP / NAT / 防火墙。
# 公共基础段见 configs/25.12-common.config；workflow 按 common + 本文件顺序拼接成 .config。
# AdGuardHome / OpenClash 选装包不内联：由 workflow 按勾选从 configs/{adgh,oc}-packages.list 注入。

# 网络核心/NAT/连接跟踪（旁路由不需要 FullCone）
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nft-nat=y
